{
  "name": "jimeng-free-api",
  "version": "0.0.6",
  "description": "🚀 免费的高级即梦(Jimeng) AI 接口服务，支持 4.x/3.x 图像模型和视频生成，OpenAI 兼容，内置可视化管理控制台。",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "directories": {
    "dist": "dist"
  },
  "files": [
    "dist/",
    ".env.example"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --target node20 --sourcemap --dts --publicDir public --watch --onSuccess \"node --enable-source-maps --no-node-snapshot dist/index.js\"",
    "dev:mcp": "tsup src/mcp/index.ts --format cjs,esm --target node20 --sourcemap --dts --watch --onSuccess \"node --enable-source-maps --no-node-snapshot dist/mcp/index.js\"",
    "start": "node --enable-source-maps --no-node-snapshot dist/index.js",
    "start:mcp": "node --enable-source-maps --no-node-snapshot dist/mcp/index.js",
    "build": "tsup src/index.ts src/mcp/index.ts --format cjs,esm --target node20 --sourcemap --dts --clean --publicDir public",
    "test": "vitest run"
  },
  "author": "Vinlic",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^11.0.0",
    "colors": "^1.4.0",
    "crc-32": "^1.2.2",
    "cron": "^3.1.6",
    "date-fns": "^3.3.1",
    "eventsource-parser": "^1.1.2",
    "form-data": "^4.0.6",
    "fs-extra": "^11.2.0",
    "koa": "^2.16.4",
    "koa-body": "^5.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-range": "^0.3.0",
    "koa-router": "^12.0.1",
    "koa2-cors": "^2.0.6",
    "lodash": "^4.18.1",
    "mime": "^4.0.1",
    "minimist": "^1.2.8",
    "randomstring": "^1.3.0",
    "uuid": "^11.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/lodash": "^4.14.202",
    "@types/mime": "^3.0.4",
    "@types/node": "^20.19.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
